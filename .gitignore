# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Salidas de entrenamiento
data/
# Sin barra final a propósito: así cubre el directorio y también un symlink `runs -> <repo>/runs`,
# que es como un worktree comparte las salidas de entrenamiento en vez de duplicarlas.
runs
*.pth
*.pt
*.mat
*.nii
*.nii.gz

# Checkpoints: se versionan los oficiales (los tests de reproducción dependen de ellos) y los
# entrenados elegidos (copias sin el estado del optimizador, 1.6 MB c/u). Las negaciones van
# DESPUÉS de *.pth, porque en git gana la última regla que coincide.
checkpoints/*
!checkpoints/Oficiales/
!checkpoints/Entrenados/
!checkpoints/Oficiales/*.pth
!checkpoints/Entrenados/*.pth

# Datasets: las imágenes no se versionan; las listas, los README y los scripts que arman
# ldm100k3d sí. Para re-incluir algo hay que excluir el CONTENIDO (dir/*) y no el directorio, porque
# git no entra en un directorio excluido.
datasets/*
!datasets/cache_ldm100k3d.py
!datasets/mascaras_ldm100k3d.py
!datasets/prepara_sim2.py
!datasets/bsds500/
datasets/bsds500/*
!datasets/bsds500/cbsd68.txt
!datasets/bsds500/README.md
!datasets/ldm100k3d/
datasets/ldm100k3d/*
!datasets/ldm100k3d/lista_*.txt
!datasets/ldm100k3d/README.md

# Herramientas de la construcción del entrenador (mediciones, veredictos, hooks): quedan locales.
scripts/

# PDFs de papers: pesados (~67 MB). Se versionan solo las notas destiladas.
docs/papers/*.pdf

# Figuras de las etapas: pesan (~33 MB) y se rehacen con sus scripts. Quedan locales.
docs/figuras/

# Cachés
.pytest_cache/
*.egg-info/

# Configuración local de agentes
.claude/
CLAUDE.md
